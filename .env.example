# StoryToon environment (copy to .env.local)

# Required for live comic generation (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional model overrides
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional — production Google Sign-In (demo mode works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Per authenticated user daily generation cap
DAILY_GENERATION_LIMIT=5
